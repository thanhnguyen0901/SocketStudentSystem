<UserControl
    x:Class="StudentClient.Wpf.Views.DbConnectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="540"
    d:DesignWidth="920"
    mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="Kết nối cơ sở dữ liệu" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="24"
                Background="White"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Máy chủ SQL" />
                        <TextBlock
                            Margin="0,6,0,18"
                            FontSize="13"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="Điền host, cổng và tên database mà server sẽ sử dụng." />

                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="Địa chỉ SQL Server" />
                        <TextBox
                            x:Name="SqlHost"
                            Margin="0,8,0,14"
                            IsEnabled="{Binding AreInputsEnabled}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="Cổng" />
                                <TextBox
                                    x:Name="SqlPort"
                                    Margin="0,8,0,0"
                                    IsEnabled="{Binding AreInputsEnabled}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="Tên cơ sở dữ liệu" />
                                <TextBox
                                    x:Name="Database"
                                    Margin="0,8,0,0"
                                    IsEnabled="{Binding AreInputsEnabled}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        Padding="20"
                        Background="{StaticResource PanelAltBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Tài khoản đăng nhập" />
                            <TextBlock
                                Margin="0,6,0,18"
                                FontSize="13"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="Sử dụng tài khoản có quyền truy cập vào database đã tạo." />

                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="Tên đăng nhập" />
                            <TextBox
                                x:Name="Username"
                                Margin="0,8,0,14"
                                IsEnabled="{Binding AreInputsEnabled}" />

                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Text="Mật khẩu" />
                            <PasswordBox
                                x:Name="PasswordBox"
                                Margin="0,8,0,0"
                                IsEnabled="{Binding AreInputsEnabled}"
                                PasswordChanged="PasswordBox_PasswordChanged" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="ConnectDb"
                    Grid.Column="0"
                    Width="220"
                    Content="Kết nối cơ sở dữ liệu" />

                <Border
                    Grid.Column="2"
                    Padding="14"
                    Background="{StaticResource SuccessBrush}"
                    CornerRadius="12">
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SuccessTextBrush}"
                            Text="TRẠNG THÁI CSDL" />
                        <TextBlock
                            x:Name="Status"
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
