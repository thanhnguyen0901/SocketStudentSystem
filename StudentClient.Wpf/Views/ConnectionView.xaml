<UserControl
    x:Class="StudentClient.Wpf.Views.ConnectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="540"
    d:DesignWidth="920"
    mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="Kết nối máy chủ" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,0,0,18"
            Padding="18"
            Background="{StaticResource PanelAltBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="16">
            <TextBlock
                FontSize="13"
                Foreground="{StaticResource TextMutedBrush}"
                Text="Gợi ý: nếu chạy server trên cùng máy, bạn có thể dùng localhost:9000." />
        </Border>

        <Border
            Grid.Row="2"
            Padding="24"
            VerticalAlignment="Top"
            Background="White"
            BorderBrush="{StaticResource BorderBrushSoft}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="Địa chỉ máy chủ" />
                        <TextBox
                            x:Name="Host"
                            Margin="0,8,0,0"
                            IsEnabled="{Binding AreInputsEnabled}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="Cổng TCP" />
                        <TextBox
                            x:Name="Port"
                            Margin="0,8,0,0"
                            IsEnabled="{Binding AreInputsEnabled}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2">
                    <Button
                        x:Name="Connect"
                        Width="180"
                        HorizontalAlignment="Left"
                        Content="Kết nối máy chủ" />
                </StackPanel>

                <Border
                    Grid.Row="4"
                    Padding="14"
                    Background="{StaticResource SuccessBrush}"
                    CornerRadius="12">
                    <StackPanel>
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource SuccessTextBrush}"
                            Text="TRẠNG THÁI KẾT NỐI" />
                        <TextBlock
                            x:Name="Status"
                            Margin="0,6,0,0"
                            FontSize="14"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
